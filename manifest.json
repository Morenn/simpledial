{
  "manifest_version": 3,
  "name": "Simple SpeedDial",
  "version": "1.0",
  "description": "Simple SpeedDial in list/grid format as newtab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage", "downloads"
  ],
  "icons": {
    "128": "icons/icon-128.ico"
  }
}
