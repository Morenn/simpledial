{
  "manifest_version": 3,
  "name": "Simple SpeedDial",
  "version": "1.0.1",
  "description": "Lightweight speeddial extension that stores and syncs bookmarks through Nextcloud or a custom JSON sync server.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "downloads",
    "bookmarks"
  ],
  "host_permissions": [],
  "optional_host_permissions": [ "*://*/*" ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
